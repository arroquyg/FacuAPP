NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Roles de usuario ────────────────────────────────────────────────────────
# Los roles se asignan en la tabla `usuarios` (columna `rol`).
# Valores posibles: administrador | operario | veterinario
#
# administrador → acceso total (transferencias, configuración, usuarios, edición masiva)
# operario      → acceso limitado a sus campos asignados (tabla usuario_campos)
# veterinario   → definido en el sistema, sin comportamiento diferenciado aún
#                 (se trata igual que operario hasta nueva implementación)
#
# Para implementar permisos específicos del veterinario, ajustar en:
#   src/lib/auth.ts       → tipo UserProfile
#   src/middleware.ts     → guards por ruta
#   src/app/**/page.tsx   → checks de rol en cada página

#Supabase arroquyg Campagnolle2026-

#Paso 1 — Crear la empresa (SQL Editor de Supabase):

INSERT INTO empresas (nombre, caravanas_compradas, caravanas_bajas)
VALUES ('Nombre de la empresa', 0, 0)
RETURNING id;

Guardá el id que devuelve, lo necesitás en el paso 2.

---
Paso 2 — Crear el usuario admin en Auth (Authentication → Users → "Add user" en el dashboard de Supabase):

- Email: email@ejemplo.com
- Password: la que quieras
- ✅ Auto Confirm User

---
Paso 3 — Crear el perfil del usuario (SQL Editor):

INSERT INTO usuarios (nombre, email, rol, empresa_id, activo)
VALUES (
  'Nombre Apellido',
  'email@ejemplo.com',         -- mismo email que en el paso 2
  'administrador',             -- o 'operario'
  'UUID-de-la-empresa',        -- el id que devolvió el paso 1
  true
);